---
// Pinned cinematic opening — portrait (layer 1) + scroll-driven reveal of layer 2
---
<section id="home" aria-label="Introduction">
  <div class="hero-sticky">
    <div class="hero-full" id="inspector" role="img"
         aria-label="Figure seen from behind in low light. Scroll or move the pointer to reveal a second layer beneath the surface.">
      <div class="hero-media" id="heroMedia">
        <img id="imgBase" alt="" src="/hero-1.jpg" width="1344" height="768"
             fetchpriority="high" decoding="async">
        <canvas id="reveal" aria-hidden="true"></canvas>
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-veil" id="heroVeil"></div>
      <div class="hero-id" id="heroId">
        <div class="hero-copy">
          <h1 class="hero-title" data-i18n="hero.title"><span>DIFENDI</span><span>ANALIZZA</span><span>PROTEGGI</span></h1>
          <p data-i18n="hero.role">Cybersecurity&nbsp;&nbsp;|&nbsp;&nbsp;Soc Analyst</p>
        </div>
      </div>
    </div>
  </div>
  <!-- snap sentinel: aggancia la vista a reveal completato (fine dello sticky) -->
  <div class="hero-snap" aria-hidden="true"></div>
</section>
