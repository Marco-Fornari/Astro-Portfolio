---
// Experience, education & skills
---
<section id="experience" aria-label="Experience, education and skills">
  <div class="sheet">
    <div class="split">
      <div class="stick">
        <p class="kicker rv" data-i18n="xp.kicker">02 / EXPERIENCE — SYSTEM HISTORY</p>
        <h2 class="rv d1">Story →<br>Code →<br>System →<br>Security</h2>
      </div>
      <div class="xp" style="margin-top:10px">
        <article class="job hot rv">
          <p class="when" data-i18n="xp.j1.when">FEB 2026 — PRESENT</p>
          <h4 data-i18n="xp.role.junior">Junior Developer</h4>
          <p class="org">OVERSIDE SRL</p>
          <p data-i18n="xp.j1.desc">Developing software solutions and security-oriented tools for email analysis, phishing detection and Business Email Compromise detection — including work on <strong style="color:var(--ink)">Overguard</strong>, an anti-phishing platform.</p>
          <div class="taglist">
            <span class="tag">C#</span><span class="tag">.NET</span><span class="tag">ASP.NET CORE WEB API</span>
            <span class="tag">POSTGRESQL</span><span class="tag">ENTITY FRAMEWORK</span><span class="tag">JWT</span>
            <span class="tag">JAVASCRIPT</span><span class="tag">FLUTTER</span>
          </div>
        </article>
        <article class="job rv">
          <p class="when" data-i18n="xp.j2.when">APR 2025 — JAN 2026</p>
          <h4 data-i18n="xp.role.junior">Junior Developer</h4>
          <p class="org">LEVANTE YACHTS SRL</p>
          <p data-i18n="xp.j2.desc">Web development, database management, API integrations, automation and frontend/backend development.</p>
          <div class="taglist">
            <span class="tag">HTML</span><span class="tag">CSS</span><span class="tag">JAVASCRIPT</span>
            <span class="tag">PHP</span><span class="tag">MYSQL</span><span class="tag">WORDPRESS APIS</span>
            <span class="tag">GOOGLE SHEETS APIS</span>
          </div>
        </article>
        <article class="job rv">
          <p class="when">2022 — 2024</p>
          <h4 data-i18n="xp.j3.role">Videomaker &amp; Photographer</h4>
          <p class="org">FREELANCER</p>
          <p data-i18n="xp.j3.desc">Managed complete audiovisual projects from briefing to final delivery. This is where the system started: critical thinking, communication, project ownership, visual thinking, planning, attention to detail and working under pressure.</p>
          <div class="taglist">
            <span class="tag">CLIENT COMMUNICATION</span><span class="tag">REQUIREMENTS GATHERING</span>
            <span class="tag">PLANNING</span><span class="tag">COORDINATION</span><span class="tag">EXECUTION</span>
            <span class="tag">DEADLINE MANAGEMENT</span><span class="tag">PROBLEM SOLVING</span>
          </div>
        </article>
      </div>
    </div>

    <div class="rule"></div>

    <h3 class="rv">Education &amp; Certifications</h3>
    <div class="edu rv d1">
      <article>
        <p class="mono-h">2024 — 2026</p>
        <h5>ITS Smart Academy</h5>
        <p class="sub" data-i18n="edu.e1.sub">INDUSTRIAL SOFTWARE DEVELOPER<br>EQF LEVEL 5 · 110/110 CUM LAUDE</p>
        <p data-i18n="edu.e1.desc">Two-year higher technical program in industrial software development.</p>
      </article>
      <article>
        <p class="mono-h">25 CFU</p>
        <h5>Università Politecnica delle Marche</h5>
        <p class="sub">CYBER RISK &amp; DATA PROTECTION</p>
        <p data-i18n="edu.e2.desc">Cybersecurity, data protection, GDPR, software security, information security, cyber risk management.</p>
      </article>
      <article>
        <p class="mono-h">2024</p>
        <h5>Google Cybersecurity Certificate</h5>
        <p class="sub">FOUNDATIONS &amp; OPERATIONS</p>
        <p data-i18n="edu.e3.desc">Python, Linux, SQL, SIEM, IDS, risk assessment, threat identification, security controls.</p>
      </article>
      <article>
        <p class="mono-h">IN PROGRESS — 2026</p>
        <h5>CEH — Certified Ethical Hacker</h5>
        <p class="sub">EC-COUNCIL</p>
        <p data-i18n="edu.e4.desc">Ethical hacking, penetration testing, vulnerability assessment, attack techniques, security controls.</p>
      </article>
    </div>

    <div class="rule"></div>

    <h3 class="rv">Skills</h3>
    <div class="skills rv d1">
      <div>
        <h3>Development</h3>
        <div class="taglist">
          <span class="tag">C#</span><span class="tag">.NET</span><span class="tag">ASP.NET CORE</span>
          <span class="tag">JAVASCRIPT</span><span class="tag">FLUTTER</span><span class="tag">SQL</span>
          <span class="tag">POSTGRESQL</span><span class="tag">MYSQL</span>
          <span class="tag">ENTITY FRAMEWORK</span><span class="tag">GIT</span>
        </div>
      </div>
      <div>
        <h3>Cybersecurity</h3>
        <div class="taglist">
          <span class="tag">PHISHING DETECTION</span><span class="tag">THREAT INTELLIGENCE</span>
          <span class="tag">CYBER RISK</span><span class="tag">RISK ASSESSMENT</span>
          <span class="tag">RISK MANAGEMENT</span><span class="tag">DATA PROTECTION</span>
          <span class="tag">DLP</span><span class="tag">APPLICATION SECURITY</span>
        </div>
      </div>
      <div>
        <h3>Tools &amp; Infrastructure</h3>
        <div class="taglist">
          <span class="tag">LINUX</span><span class="tag">BASH</span><span class="tag">DOCKER</span>
          <span class="tag">REST APIS</span><span class="tag">JWT</span>
        </div>
      </div>
      <div>
        <h3>Human skills</h3>
        <div class="taglist">
          <span class="tag">CRITICAL THINKING</span><span class="tag">ANALYTICAL THINKING</span>
          <span class="tag">TECHNICAL COMMUNICATION</span><span class="tag">PROBLEM SOLVING</span>
          <span class="tag">CLIENT COMMUNICATION</span><span class="tag">ADAPTABILITY</span>
          <span class="tag">ATTENTION TO DETAIL</span><span class="tag">PROJECT MANAGEMENT</span>
        </div>
      </div>
    </div>
  </div>
</section>
