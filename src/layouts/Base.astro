---
import "../styles/global.css";
const { title = "Marco Fornari — Cybersecurity · Soc Analyst",
        description = "Marco Fornari. Junior profile in cybersecurity and system engineering: security event monitoring, log analysis, threat intelligence and security-oriented development." } = Astro.props;
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preload" as="image" href="/hero-1.jpg" />
</head>
<body data-route="home">
  <div id="progress" aria-hidden="true"></div>
  <canvas id="system" aria-hidden="true"></canvas>

  <button id="scrollBtn" class="scroll-btn" type="button" aria-label="Scroll to next section">
    <span class="mouse" aria-hidden="true">
      <svg viewBox="0 0 26 44">
        <rect x="1.5" y="1.5" width="23" height="41" rx="11.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
        <circle class="wheel" cx="13" cy="12" r="2.2" fill="currentColor"/>
      </svg>
    </span>
    <svg class="chevron" viewBox="0 0 20 10" aria-hidden="true">
      <path d="M1.5 1.5l8.5 7 8.5-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <header>
    <a class="id" href="#home" aria-label="Back to top">
      <b>MARCO FORNARI</b>
      <span>CYBERSECURITY </span>
    </a>
    <nav aria-label="Primary">
      <a href="#home" data-route="home" class="home-link">HOME</a>
      <a href="#about" data-route="about"><i>01 /</i>ABOUT</a>
      <a href="#experience" data-route="experience"><i>02 /</i>EXPERIENCE</a>
      <a href="#contact" data-route="contact"><i>03 /</i>CONTACT</a>
    </nav>
    <div class="hright">
      <div class="lang" role="group" aria-label="Language">
        <button data-lang="it" class="on" type="button">IT</button>
        <span aria-hidden="true">/</span>
        <button data-lang="en" type="button">EN</button>
      </div>
      <button id="themeBtn" class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">◐</button>
      <div class="index" aria-hidden="true"><b id="idxCur">01</b> / 04</div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <script>
    // Astro bundles this module graph (Vite) into a hashed /_astro/ asset.
    import "../scripts/main.js";
  </script>
</body>
</html>
